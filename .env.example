# Copy to `.env` and fill in secrets before running `docker compose up -d`.

# Required PostgreSQL credentials for the `postgres` service
POSTGRES_DB=agentdbctl
POSTGRES_USER=agentdbctl
POSTGRES_PASSWORD=change-me-postgres-password

# Required 32-byte key (64 hex chars or base64), e.g. `openssl rand -hex 32`
AGENT_DBCTL_MASTER_KEY=

# Optional bootstrap admin password used once when the database has no users yet
AGENT_DBCTL_BOOTSTRAP_ADMIN_PASSWORD=

# Host interface/port binding for agent-dbctl (defaults to loopback only)
AGENT_DBCTL_BIND_ADDR=127.0.0.1:8080

# Public origin seen by browsers and `agent-dbctl context add`
# Non-loopback URLs must use https://
AGENT_DBCTL_PUBLIC_URL=http://127.0.0.1:8080

# Optional custom config path relative to repository root
# AGENT_DBCTL_CONFIG_FILE=./deploy/server.yaml.example

# Optional Caddy hostname when running `docker compose --profile tls up -d`
SITE_HOST=localhost

# Optional OIDC client secret when auth.oidc.enabled=true
AGENT_DBCTL_OIDC_SECRET=
